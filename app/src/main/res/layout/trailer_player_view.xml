<?xml version="1.0" encoding="utf-8"?>
<!-- Trailer video surface (Step 59 letterbox detection): PlayerView in
     Media3 1.4.1 has no setVideoSurfaceType / setVideoTextureView — the
     surface type comes from this layout's app:surface_type, so the surface
     is a TextureView whose frames can be sampled via TextureView.bitmap. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
